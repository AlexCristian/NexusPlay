package web

import "github.com/AlexCristian/NexusPlay/internal/store"

templ controlPanel(page Page, pending []store.Media, collections []store.Collection, categories []string, metadataEnabled bool, conversions ConversionView, message string) {
	@shell(page) {
		<section class="panel admin">
			<header class="admin-header">
				<h1>Control panel</h1>
				<form method="post" action="/admin/scan">
					<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
					<button type="submit" class="button button-quiet">
						@icon("refresh")
						Scan library now
					</button>
				</form>
			</header>
			if message != "" {
				@alert("success", message)
			}
			if !metadataEnabled {
				@alert("info", "Metadata lookups are off. Set NEXUSPLAY_TMDB_API_KEY to fetch posters, titles and descriptions automatically.")
			}
			<h2>Waiting to be published</h2>
			if len(pending) == 0 {
				<p class="muted">Nothing new. Files added to the media folder show up here after the next scan.</p>
			} else {
				<table class="admin-table pending-table">
					<thead>
						<tr><th scope="col">File</th><th scope="col">Detected as</th><th scope="col"></th></tr>
					</thead>
					<tbody>
						for _, mediaItem := range pending {
							<tr>
								<td class="path">{ mediaItem.Path }</td>
								<td>{ detectedAs(mediaItem) }</td>
								<td><a class="button button-small" href={ templ.SafeURL("/admin/media/" + formatInteger(mediaItem.ID)) }>Review and publish</a></td>
							</tr>
						}
					</tbody>
				</table>
			}
			@conversionsSection(page.Viewer.CSRF, conversions)
			<h2>Collections</h2>
			if len(collections) > 0 {
				<table class="admin-table">
					<thead>
						<tr><th scope="col">Name</th><th scope="col">Category</th><th scope="col">Year</th><th scope="col"></th></tr>
					</thead>
					<tbody>
						for _, collection := range collections {
							<tr>
								<td>{ collection.Name }</td>
								<td>{ collection.Category }</td>
								<td>{ collection.Year }</td>
								<td><a class="button button-small" href={ templ.SafeURL("/admin/collections/" + formatInteger(collection.ID)) }>Edit</a></td>
							</tr>
						}
					</tbody>
				</table>
			}
			<details class="admin-new">
				<summary>New collection</summary>
				<form class="form-grid" method="post" action="/admin/collections" enctype="multipart/form-data">
					<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
					@collectionFields(store.Collection{Category: "TV Shows"}, categories, metadataEnabled)
					<div class="form-actions">
						<button type="submit" class="button">Create collection</button>
					</div>
				</form>
			</details>
			@categoryList(categories)
		</section>
	}
}

templ categoryList(categories []string) {
	<datalist id="categories">
		<option value="Movies"></option>
		<option value="TV Shows"></option>
		for _, category := range categories {
			if category != "Movies" && category != "TV Shows" {
				<option value={ category }></option>
			}
		}
	</datalist>
}

templ collectionFields(collection store.Collection, categories []string, metadataEnabled bool) {
	<label>
		Name
		<textarea name="name" class="grow" rows="1" required maxlength="200">{ collection.Name }</textarea>
	</label>
	<label>
		Category
		<input type="text" name="category" value={ collection.Category } list="categories" required maxlength="50"/>
	</label>
	<label>
		Year
		<input type="text" name="year" value={ collection.Year } inputmode="numeric" maxlength="9"/>
	</label>
	<label class="span-2">
		Description
		<textarea name="overview" rows="3">{ collection.Overview }</textarea>
	</label>
	@posterField(collection.Poster, "")
	if metadataEnabled {
		<label class="check">
			<input type="checkbox" name="lookup" value="1"/>
			Fill in missing details and poster from TMDB
		</label>
	}
}

// posterField is the poster upload, with a box to remove the current poster
// when there is one.
templ posterField(current, note string) {
	<label>
		Poster image
		<input type="file" name="poster" accept="image/jpeg,image/png,image/webp"/>
		if note != "" {
			<small>{ note }</small>
		}
	</label>
	if current != "" {
		<label class="check">
			<input type="checkbox" name="remove_poster" value="1"/>
			Remove the current poster
		</label>
	}
}

templ editCollectionPage(page Page, collection store.Collection, categories []string, metadataEnabled bool, message string) {
	@shell(page) {
		<section class="panel admin">
			<p><a href="/admin">← Control panel</a></p>
			<h1>Edit collection</h1>
			if message != "" {
				@alert("error", message)
			}
			<div class="edit-layout">
				<img class="edit-poster" src={ posterURL(collection.Poster) } alt="" width="140" height="210"/>
				<form class="form-grid" method="post" action={ templ.SafeURL("/admin/collections/" + formatInteger(collection.ID)) } enctype="multipart/form-data">
					<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
					@collectionFields(collection, categories, metadataEnabled)
					<div class="form-actions">
						<button type="submit" class="button">Save</button>
					</div>
				</form>
			</div>
			<form method="post" action={ templ.SafeURL("/admin/collections/" + formatInteger(collection.ID) + "/delete") } class="danger-zone" data-confirm="Delete this collection? Its episodes stay in the library as standalone items.">
				<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
				<button type="submit" class="button button-danger">Delete collection</button>
			</form>
			@categoryList(categories)
		</section>
	}
}

templ editMediaPage(page Page, form MediaForm) {
	@shell(page) {
		<section class="panel admin">
			<p><a href="/admin">← Control panel</a></p>
			if form.Media.Published {
				<h1>Edit media</h1>
			} else {
				<h1>Review and publish</h1>
			}
			<p class="path">{ form.Media.Path }</p>
			<p class="muted">{ techSummary(form.Media) }</p>
			if form.Error != "" {
				@alert("error", form.Error)
			}
			if form.Saved {
				@alert("success", "Saved.")
			}
			if form.Refreshed {
				@alert("success", "Details refreshed from TMDB.")
			}
			<div class="edit-layout">
				<img class="edit-poster" src={ posterURL(form.Media.Poster) } alt="" width="140" height="210"/>
				<form class="form-grid" method="post" action={ templ.SafeURL("/admin/media/" + formatInteger(form.Media.ID)) } enctype="multipart/form-data">
					<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
					<label>
						Title
						<textarea name="title" class="grow" rows="1" required maxlength="200">{ form.Media.Title }</textarea>
					</label>
					<label>
						Year
						<input type="text" name="year" value={ form.Media.Year } inputmode="numeric" maxlength="9"/>
					</label>
					<label>
						Category
						<input type="text" name="category" value={ form.Media.Category } list="categories" maxlength="50" placeholder="Movies"/>
						<small>Ignored for episodes: they appear under their collection's category.</small>
					</label>
					<label>
						Collection
						<input type="text" name="collection" value={ form.CollectionName } list="collections" maxlength="200" placeholder="None (standalone)"/>
						<small>A new name creates the collection.</small>
					</label>
					<label>
						Season
						<input type="number" name="season" value={ blankZero(form.Media.Season) } placeholder="—" min="0" max="999"/>
					</label>
					<div class="field-group">
						<span class="field-label" id="episodes-label">Episodes</span>
						<span class="range-fields" role="group" aria-labelledby="episodes-label">
							<input type="number" name="episode" value={ blankZero(form.Media.Episode) } placeholder="—" min="0" max="9999" aria-label="First episode"/>
							<span>to</span>
							<input type="number" name="episode_end" value={ blankZero(form.Media.EpisodeEnd) } placeholder="—" min="0" max="9999" aria-label="Last episode (for a file with several)"/>
						</span>
						<small>Fill in “to” only for a file that holds several episodes.</small>
					</div>
					<label class="span-2">
						Description
						<textarea name="overview" rows="3">{ form.Media.Overview }</textarea>
					</label>
					@posterField(ownPoster(form.Media), "Episodes use their collection's poster when they have none.")
					<div class="form-actions">
						if form.Media.Published {
							<button type="submit" class="button">Save</button>
						} else {
							<button type="submit" name="publish" value="1" class="button">Save and publish</button>
							<button type="submit" class="button button-quiet">Save without publishing</button>
						}
						if form.MetadataEnabled {
							<button
								type="submit"
								class="button button-quiet"
								formaction={ templ.SafeURL("/admin/media/" + formatInteger(form.Media.ID) + "/refresh-metadata") }
								formnovalidate
								title="Look this item up on TMDB again and replace its title, year, description and poster. Unsaved changes on this page are discarded."
							>Refresh metadata</button>
						}
					</div>
				</form>
			</div>
			<h2>Subtitles</h2>
			if len(form.Subtitles) == 0 {
				<p class="muted">No subtitles yet. Upload one below, or put a file named like the video (for example <code>Movie.en.srt</code>) next to it.</p>
			} else {
				<table class="admin-table subtitle-table">
					<tbody>
						for _, track := range form.Subtitles {
							<tr>
								<td colspan="2">
									<form class="inline-fields" method="post" action={ templ.SafeURL("/admin/subtitles/" + formatInteger(track.ID)) }>
										<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
										<label>
											Language code
											<input type="text" name="language" value={ track.Language } required maxlength="12"/>
										</label>
										<label>
											Label
											<input type="text" name="label" value={ track.Label } required maxlength="60"/>
										</label>
										<button type="submit" class="button button-small">Save</button>
									</form>
								</td>
								<td>
									<form method="post" action={ templ.SafeURL("/admin/subtitles/" + formatInteger(track.ID) + "/delete") } data-confirm="Delete this subtitle track and its proposed corrections?">
										<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
										<button type="submit" class="button button-small button-danger">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
			<form class="form-grid upload-sub" method="post" action={ templ.SafeURL("/admin/media/" + formatInteger(form.Media.ID) + "/subtitles") } enctype="multipart/form-data">
				<input type="hidden" name="csrf_token" value={ page.Viewer.CSRF }/>
				<label>
					Subtitle file (.srt or .vtt)
					<input type="file" name="file" accept=".srt,.vtt,text/vtt" required/>
				</label>
				<label>
					Language code
					<input type="text" name="language" required maxlength="12" placeholder="en"/>
				</label>
				<div class="form-actions">
					<button type="submit" class="button">Upload subtitle</button>
				</div>
			</form>
			<datalist id="collections">
				for _, collection := range form.Collections {
					<option value={ collection.Name }></option>
				}
			</datalist>
			@categoryList(form.Categories)
		</section>
	}
}
