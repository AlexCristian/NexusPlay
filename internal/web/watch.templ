package web

import (
	"strconv"

	"github.com/AlexCristian/NexusPlay/internal/store"
)

templ watchPage(p Page, m store.Media, pb Playback, subs []store.Subtitle, resumeAt float64) {
	@shell(p) {
		<script src={ asset("/static/js/player.js") } defer></script>
		<div class="player-container" id="player-container">
			<video
				id="player"
				class="player"
				controls
				playsinline
				preload="metadata"
				data-media-id={ itoa(m.ID) }
				data-src={ pb.URL }
				data-hls={ strconv.FormatBool(!pb.Direct) }
				data-resume={ fmtSeconds(resumeAt) }
				data-duration={ fmtSeconds(m.Duration) }
				data-hls-script={ asset("/static/vendor/hls.light.min.js") }
				data-signed-in={ strconv.FormatBool(p.V.User != nil) }
			>
				for _, s := range subs {
					<track kind="subtitles" id={ "sub-" + itoa(s.ID) } src={ "/subtitles/" + itoa(s.ID) } srclang={ s.Language } label={ s.Label }/>
				}
			</video>
			<button type="button" class="big-play" id="big-play" aria-label="Play" hidden>
				@icon("play")
			</button>
			<div class="player-spinner" id="player-spinner" role="status" aria-label="Loading" hidden></div>
			<p id="player-status" class="player-status" role="alert" hidden></p>
			@playerControls(len(subs) > 0)
		</div>
		<section class="video-content">
			if p.V.User != nil {
				<div class="player-actions">
					if p.V.IsAdmin() {
						<a class="player-action" href={ templ.SafeURL("/admin/media/" + itoa(m.ID)) } title="Edit metadata" aria-label="Edit metadata">
							@icon("pencil")
						</a>
					}
					<button type="button" id="report-subtitle" class="player-action" title="Report a subtitle error" aria-label="Report a subtitle error" hidden>
						@icon("flag")
					</button>
				</div>
			}
			<div class="metadata">
				if m.CollectionID != 0 {
					<a href={ templ.SafeURL(collectionURL(m.CollectionID)) } hx-get={ collectionURL(m.CollectionID) } hx-target="#modal-body" class="watch-poster" title={ "All episodes of " + m.CollectionName }>
						<img src={ posterURL(m.Poster) } alt={ m.CollectionName } width="120" height="180"/>
					</a>
					<div class="meta-text">
						<h1>{ m.CollectionName }<span class="episode-title">{ episodeLabel(m) + ": " + m.Title }</span></h1>
						if m.Overview != "" {
							<p class="overview">{ m.Overview }</p>
						}
					</div>
				} else {
					<span class="watch-poster">
						<img src={ posterURL(m.Poster) } alt="" width="120" height="180"/>
					</span>
					<div class="meta-text">
						<h1>{ m.Title }</h1>
						if m.Year != "" {
							<p class="meta-sub">Released in { m.Year }</p>
						}
						if m.Overview != "" {
							<p class="overview">{ m.Overview }</p>
						}
					</div>
				}
			</div>
		</section>
	}
}

// playerControls is the control bar under the video, in the original's
// style: a dark gradient bar with red progress and volume. player.js shows it
// and hides the browser's own controls; without JavaScript the browser's
// controls stay.
templ playerControls(hasSubtitles bool) {
	<div class="controls" id="controls" hidden>
		<button type="button" class="ctl" id="ctl-play" aria-label="Play">
			@icon("play")
			@icon("pause")
		</button>
		<input type="range" class="rail" id="ctl-seek" min="0" max="1000" step="1" value="0" aria-label="Seek"/>
		<span class="time"><span id="ctl-time">00:00</span><span class="time-sep">|</span><span id="ctl-duration">00:00</span></span>
		if hasSubtitles {
			<span class="ctl-wrap">
				<button type="button" class="ctl" id="ctl-captions" aria-label="Subtitles" aria-haspopup="true" aria-expanded="false">
					@icon("captions")
				</button>
				<div class="captions-menu" id="captions-menu" role="menu" hidden></div>
			</span>
		}
		<button type="button" class="ctl" id="ctl-mute" aria-label="Mute">
			@icon("volume")
			@icon("volume-x")
		</button>
		<input type="range" class="volume" id="ctl-volume" min="0" max="1" step="0.05" value="1" aria-label="Volume"/>
		<button type="button" class="ctl" id="ctl-fullscreen" aria-label="Full screen">
			@icon("maximize")
			@icon("minimize")
		</button>
	</div>
}

templ subtitleReport(csrf string, track store.Subtitle, cue store.Cue, changes []store.Change, msg, msgKind string) {
	<div class="report" id="subtitle-report">
		<h2 id="modal-title" class="modal-heading">Report a subtitle error</h2>
		<div class="report-body">
			if msg != "" {
				@alert(msgKind, msg)
			}
			if len(changes) > 0 {
				<h3>Vote up a proposed change</h3>
				<ul class="changes">
					for _, c := range changes {
						<li class="proposed-change">
							<div class="original-sub">{ c.OriginalText }</div>
							<div class="changed-sub">
								<span>{ c.ProposedText }</span>
								<button
									type="button"
									class={ "vote-box", templ.KV("voted", c.VotedByMe) }
									hx-post={ "/changes/" + itoa(c.ID) + "/vote" }
									hx-target="#subtitle-report"
									hx-swap="outerHTML"
									title="Vote for this correction"
									disabled?={ c.VotedByMe }
								>
									<span class="count-votes">{ strconv.Itoa(c.Votes) }</span>
									@icon("thumbs-up")
								</button>
							</div>
						</li>
					}
				</ul>
				<h3>or submit your own</h3>
			} else {
				<h3>Submit a correction</h3>
			}
			<form
				class="proposed-change"
				method="post"
				action={ templ.SafeURL("/cues/" + itoa(cue.ID) + "/changes") }
				hx-post={ "/cues/" + itoa(cue.ID) + "/changes" }
				hx-target="#subtitle-report"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<div class="original-sub">{ cue.Text }</div>
				<div class="changed-sub">
					<textarea name="text" rows="1" required maxlength="500" aria-label={ "Corrected line (" + track.Label + ", " + cueTime(cue.StartMS) + ")" }>{ cue.Text }</textarea>
					<button type="submit" class="vote-box" title="Submit your correction">
						<span class="count-votes">0</span>
						@icon("thumbs-up")
					</button>
				</div>
			</form>
		</div>
	</div>
}
