package web

templ layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#c21f00"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles": false, "allowEval": false, "allowScriptTags": false, "responseHandling": [{"code": "204", "swap": false}, {"code": "[23]..", "swap": true}, {"code": "[45]..", "swap": true, "error": true}]}'/>
			if p.Title != "" {
				<title>{ p.Title } · Nexus Play</title>
			} else {
				<title>Nexus Play</title>
			}
			<link rel="icon" href={ asset("/static/img/icon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script src={ asset("/static/vendor/htmx.min.js") } defer></script>
			<script src={ asset("/static/js/app.js") } defer></script>
		</head>
		{ children... }
	</html>
}

// shell is the body every page shares: top bar, search, content, modal and
// footer.
templ shell(p Page) {
	@shellWithSearch(p, nil) {
		{ children... }
	}
}

// shellWithSearch is shell with the search drawer already open on results,
// for /search without JavaScript. The drawer slides down over the top of the
// page and dims everything under it (#page-cover); app.js opens and closes
// it as search results come and go.
templ shellWithSearch(p Page, results templ.Component) {
	@layout(p) {
		<!-- hx-headers carries the CSRF token for htmx; player.js reads it too. -->
		<body hx-headers={ csrfHeaders(p.Viewer) }>
			@topBar(p)
			<main class="page">
				<div class="above-panel">
					@searchBox(p.Query)
				</div>
				<div id="search-drawer" class={ "search-drawer", templ.KV("open", results != nil) }>
					<div class="search-drawer-inner">
						<div id="search-results">
							if results != nil {
								@results
							}
						</div>
					</div>
				</div>
				<div id="page-cover" class={ "page-cover", templ.KV("dimmed", results != nil) }>
					{ children... }
				</div>
			</main>
			<footer class="footer">
				Built on Nexus Play, an open-source web media center.
				<a href="https://github.com/AlexCristian/NexusPlay">Source code</a>
			</footer>
			<dialog id="modal" class="modal" aria-labelledby="modal-title" tabindex="-1">
				<button type="button" class="modal-close" data-close-modal aria-label="Close">
					@icon("x")
				</button>
				<div id="modal-body"></div>
			</dialog>
		</body>
	}
}

templ topBar(p Page) {
	<header id="top-bar" class="top-bar">
		<nav class="top-bar-inner" aria-label="Main">
			<a class="brand" href="/">
				@icon("play")
				Nexus Play
			</a>
			if p.Viewer.User != nil {
				<button type="button" class="top-link" aria-label="Previously watching" title="Previously watching" popovertarget="resume-pop" hx-get="/me/resume" hx-target="#resume-pop-body" hx-trigger="click">
					<span class="label-long">Previously watching</span><span class="label-short">@icon("history")</span>
				</button>
				<div id="resume-pop" class="popover" popover>
					<h2 class="popover-title">Resume paused media</h2>
					<div id="resume-pop-body"></div>
				</div>
				<button type="button" class="top-link" aria-label="My subscriptions" title="My subscriptions" popovertarget="notif-pop" hx-get="/me/notifications" hx-target="#notif-pop-body" hx-trigger="click">
					<span class="label-long">My subscriptions</span><span class="label-short">@icon("bell")</span>
				</button>
				<div id="notif-pop" class="popover" popover>
					<h2 class="popover-title">New in your subscriptions</h2>
					<div id="notif-pop-body"></div>
				</div>
				<span class="spacer"></span>
				if p.Viewer.IsAdmin() {
					<a class="top-link" href="/admin" aria-label="Control panel" title="Control panel"><span class="label-long">Control panel</span><span class="label-short">@icon("settings")</span></a>
				}
				<span class="top-text">Welcome, { p.Viewer.User.Nickname }</span>
				<form method="post" action="/logout" class="inline-form">
					<input type="hidden" name="csrf_token" value={ p.Viewer.CSRF }/>
					<button type="submit" class="top-link" aria-label="Log out" title="Log out"><span class="label-long">Log out</span><span class="label-short">@icon("log-out")</span></button>
				</form>
			} else {
				<span class="spacer"></span>
				<a class="top-link" href="/login" hx-get="/login" hx-target="#modal-body">Log in</a>
				<a class="top-link" href="/register" hx-get="/register" hx-target="#modal-body">Register</a>
			}
		</nav>
	</header>
}

templ searchBox(q string) {
	<form class="search" action="/search" method="get" role="search">
		@icon("search")
		<input
			type="search"
			name="q"
			value={ q }
			placeholder="Search media..."
			aria-label="Search media"
			autocomplete="off"
			hx-get="/search"
			hx-trigger="input changed delay:250ms, search"
			hx-target="#search-results"
			hx-sync="this:replace"
		/>
	</form>
}

templ messagePage(p Page, title, msg string) {
	@shell(p) {
		<section class="panel message">
			<h1 class="message-heading">{ title }</h1>
			<div class="message-body">
				<p>{ msg }</p>
				<p><a href="/">Back to the library</a></p>
			</div>
		</section>
	}
}

// clampedText is a description shown a few lines tall with a round arrow
// button to expand it (app.js shows the button only when the text is cut).
templ clampedText(text string) {
	<div class="clamp">
		<p class="overview">{ text }</p>
		<button type="button" class="clamp-toggle" aria-expanded="false" aria-label="Show the whole description" title="Show the whole description" hidden>
			@icon("chevron-down")
		</button>
	</div>
}

templ alert(kind, msg string) {
	<div class={ "alert", "alert-" + kind } role="status">{ msg }</div>
}
