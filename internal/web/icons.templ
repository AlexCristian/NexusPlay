package web

// icon renders an inline Lucide icon (https://lucide.dev, ISC license).
templ icon(name string) {
	<svg class={ "icon", "icon-" + name } xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "play":
				<polygon points="6 3 20 12 6 21 6 3"></polygon>
			case "x":
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			case "search":
				<circle cx="11" cy="11" r="8"></circle>
				<path d="m21 21-4.3-4.3"></path>
			case "check":
				<path d="M20 6 9 17l-5-5"></path>
			case "thumbs-up":
				<path d="M7 10v12"></path>
				<path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"></path>
			case "pencil":
				<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
				<path d="m15 5 4 4"></path>
			case "flag":
				<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
				<line x1="4" x2="4" y1="22" y2="15"></line>
			case "pause":
				<rect x="14" y="4" width="4" height="16" rx="1"></rect>
				<rect x="6" y="4" width="4" height="16" rx="1"></rect>
			case "volume":
				<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path>
				<path d="M16 9a5 5 0 0 1 0 6"></path>
				<path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path>
			case "volume-x":
				<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path>
				<line x1="22" x2="16" y1="9" y2="15"></line>
				<line x1="16" x2="22" y1="9" y2="15"></line>
			case "maximize":
				<path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
				<path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
				<path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
				<path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
			case "minimize":
				<path d="M8 3v3a2 2 0 0 1-2 2H3"></path>
				<path d="M21 8h-3a2 2 0 0 1-2-2V3"></path>
				<path d="M3 16h3a2 2 0 0 1 2 2v3"></path>
				<path d="M16 21v-3a2 2 0 0 1 2-2h3"></path>
			case "captions":
				<rect width="18" height="14" x="3" y="5" rx="2" ry="2"></rect>
				<path d="M7 15h4M15 15h2M7 11h2M13 11h4"></path>
			case "star":
				<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
			case "history":
				<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
				<path d="M3 3v5h5"></path>
				<path d="M12 7v5l4 2"></path>
			case "settings":
				<path d="M20 7h-9"></path>
				<path d="M14 17H5"></path>
				<circle cx="17" cy="17" r="3"></circle>
				<circle cx="7" cy="7" r="3"></circle>
			case "log-out":
				<path d="m16 17 5-5-5-5"></path>
				<path d="M21 12H9"></path>
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
			case "bell":
				<path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
				<path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
			case "refresh":
				<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
				<path d="M21 3v5h-5"></path>
				<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
				<path d="M8 16H3v5"></path>
		}
	</svg>
}
