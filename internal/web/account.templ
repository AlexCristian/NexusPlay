package web

import "github.com/AlexCristian/NexusPlay/internal/auth"

templ authPage(p Page, form templ.Component) {
	@shell(p) {
		<section class="panel auth-panel">
			@form
		</section>
	}
}

templ loginForm(errMsg, email, next string) {
	<div class="auth" id="auth-form">
		<h2 id="modal-title" class="modal-heading">Log in</h2>
		<form class="auth-body" method="post" action="/login" hx-post="/login" hx-target="#auth-form" hx-swap="outerHTML">
			if errMsg != "" {
				@alert("error", errMsg)
			}
			<input type="hidden" name="next" value={ next }/>
			<label>
				E-mail
				<span class="field"><span class="addon" aria-hidden="true">{ "@" }</span><input type="email" name="email" value={ email } required autocomplete="email" autofocus/></span>
			</label>
			<label>
				Password
				<span class="field"><span class="addon" aria-hidden="true">?</span><input type="password" name="password" required autocomplete="current-password"/></span>
			</label>
			<button type="submit" class="button">Log in</button>
			<p class="auth-switch">
				Not registered yet?
				<a href="/register" hx-get="/register" hx-target="#auth-form" hx-swap="outerHTML">Create an account</a>
			</p>
		</form>
	</div>
}

templ registerForm(errMsg, email, nickname string, st auth.RegistrationStatus) {
	<div class="auth" id="auth-form">
		<h2 id="modal-title" class="modal-heading">Register</h2>
		if st.Closed {
			<div class="auth-body">
				@alert("info", registrationClosedMessage(st.MaxAccounts))
				<p class="auth-switch">
					Already registered?
					<a href="/login" hx-get="/login" hx-target="#auth-form" hx-swap="outerHTML">Log in</a>
				</p>
			</div>
		} else {
			<form class="auth-body" method="post" action="/register" hx-post="/register" hx-target="#auth-form" hx-swap="outerHTML">
				if errMsg != "" {
					@alert("error", errMsg)
				}
				if st.FirstUser {
					@alert("info", "This is the first account on this server, so it becomes the administrator.")
				}
				<label>
					Nickname
					<span class="field"><span class="addon" aria-hidden="true">Aa</span><input type="text" name="nickname" value={ nickname } required maxlength="40" autocomplete="username" autofocus/></span>
				</label>
				<label>
					E-mail
					<span class="field"><span class="addon" aria-hidden="true">{ "@" }</span><input type="email" name="email" value={ email } required autocomplete="email"/></span>
				</label>
				<label>
					Password
					<span class="field"><span class="addon" aria-hidden="true">?</span><input type="password" name="password" required minlength="8" autocomplete="new-password"/></span>
				</label>
				<button type="submit" class="button">Create account</button>
				<p class="auth-note">
					An account lets you resume playback where you left off, subscribe to shows
					and help correct subtitles.
				</p>
				<p class="auth-switch">
					Already registered?
					<a href="/login" hx-get="/login" hx-target="#auth-form" hx-swap="outerHTML">Log in</a>
				</p>
			</form>
		}
	</div>
}
