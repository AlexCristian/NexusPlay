package web

import (
	"fmt"
	"strconv"

	"github.com/AlexCristian/NexusPlay/internal/collections"
	"github.com/AlexCristian/NexusPlay/internal/store"
)

templ homePage(page Page, recent []store.Tile, categories []store.Category) {
	@shell(page) {
		<section class="panel library-panel">
			<div id="library">
				@libraryView(page, recent, categories)
			</div>
			<div class="featurette">
				<h2><strong>Nexus Play</strong><span class="muted">, the open-source web media center.</span></h2>
				<p class="lead">
					Easily access your media anytime, anywhere. Nexus Play is a lightweight, self-hosted
					media center: your own personal streaming service, with the benefits of open-source software.
				</p>
			</div>
		</section>
	}
}

templ libraryView(page Page, recent []store.Tile, categories []store.Category) {
	if len(recent) == 0 && len(categories) == 0 {
		<div class="empty">
			<h2>Your library is empty</h2>
			if page.Viewer.IsAdmin() {
				<p>Add videos to the media folder, then publish them from the <a href="/admin">control panel</a>.</p>
			} else {
				<p>Nothing has been published yet. Check back soon.</p>
			}
		</div>
	} else {
		<div class="tabs" data-tabs>
			<div class="tab-list" role="tablist">
				<button type="button" role="tab" class="tab" aria-selected="true" data-tab="tab-recent">Just added</button>
				for i, category := range categories {
					<button type="button" role="tab" class="tab" aria-selected="false" data-tab={ fmt.Sprintf("tab-%d", i) }>{ category.Name }</button>
				}
			</div>
			<div class="tile-strip">
				<div class="tab-panel" id="tab-recent" role="tabpanel">
					@tileGrid(recent)
				</div>
				for i, category := range categories {
					<div class="tab-panel" id={ fmt.Sprintf("tab-%d", i) } role="tabpanel" hidden>
						@tileGrid(category.Tiles)
					</div>
				}
			</div>
		</div>
	}
}

// searchResults fills the search drawer: "Search for" and a tab per
// category, as on the home page. With nothing found it renders nothing, and
// the drawer closes.
templ searchResults(categories []store.Category) {
	if len(categories) > 0 {
		<section class="panel library-panel search-panel">
			<div class="tabs" data-tabs>
				<div class="tab-list" role="tablist">
					<span class="tab tab-label">Search for</span>
					for i, category := range categories {
						<button type="button" role="tab" class="tab" aria-selected={ strconv.FormatBool(i == 0) } data-tab={ fmt.Sprintf("search-tab-%d", i) }>{ category.Name }</button>
					}
				</div>
				<div class="tile-strip">
					for i, category := range categories {
						<div class="tab-panel" id={ fmt.Sprintf("search-tab-%d", i) } role="tabpanel" hidden?={ i != 0 }>
							@tileGrid(category.Tiles)
						</div>
					}
				</div>
			</div>
		</section>
	}
}

templ tileGrid(tiles []store.Tile) {
	<ul class="tiles">
		for _, tile := range tiles {
			<li>
				if tile.IsCollection {
					<a class="tile" href={ templ.SafeURL(collectionURL(tile.ID)) } hx-get={ collectionURL(tile.ID) } hx-target="#modal-body">
						@tileBody(tile)
					</a>
				} else {
					<a class="tile" href={ watchURL(tile.ID) }>
						@tileBody(tile)
					</a>
				}
			</li>
		}
	</ul>
}

templ tileBody(tile store.Tile) {
	<img src={ posterURL(tile.Poster) } alt="" loading="lazy" width="140" height="210"/>
	<span class="tile-title" title={ tile.Title } dir="auto">{ tile.Title }</span>
	<span class="tile-meta">
		if tile.Watched {
			<span class="watched" title="Watched">
				@icon("check")
			</span>
		}
		{ tile.Year }
	</span>
}

templ collectionDialog(viewer Viewer, collection store.Collection, seasons []Season, subscribed bool, watched collections.Set[int64]) {
	<div class="collection">
		<header class="collection-header">
			<div class="poster-wrapper">
				<img src={ posterURL(collection.Poster) } alt="" width="140" height="210"/>
				if viewer.User != nil {
					@subscribeRibbon(collection.ID, subscribed)
				}
			</div>
			<div class="collection-meta">
				<h2 id="modal-title" title={ collection.Name }>{ collection.Name }</h2>
				<p class="collection-sub">{ seasonSummary(collection, seasons) }</p>
				if len(seasons) > 0 {
					<div class="season-tabs" role="tablist" data-tabs data-tabs-scope=".collection">
						for i, season := range seasons {
							<button
								type="button"
								role="tab"
								class="season-tab"
								aria-selected={ strconv.FormatBool(i == 0) }
								data-tab={ fmt.Sprintf("season-%d-%d", collection.ID, season.Number) }
							>{ seasonLabel(season.Number) }</button>
						}
					</div>
				}
			</div>
		</header>
		<div class="collection-body">
			if collection.Overview != "" {
				@clampedText(collection.Overview)
			}
			for i, season := range seasons {
				<div class="tab-panel" id={ fmt.Sprintf("season-%d-%d", collection.ID, season.Number) } role="tabpanel" hidden?={ i != 0 }>
					<table class="episodes">
						<thead>
							<tr><th scope="col">Episode</th><th scope="col">Title</th></tr>
						</thead>
						<tbody>
							for _, episode := range season.Episodes {
								<tr>
									<td>{ episodeNumbers(episode) }</td>
									<td>
										<a href={ watchURL(episode.ID) }>{ episode.Title }</a>
										if watched.Contains(episode.ID) {
											<span class="watched" title="Watched">
												@icon("check")
											</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</div>
	</div>
}

// subscribeRibbon is the diagonal ribbon in the corner of a collection's
// poster, as in the original: blue with a star to subscribe, green with a
// check mark once subscribed.
templ subscribeRibbon(collectionID int64, subscribed bool) {
	<button
		type="button"
		id="subscribe-ribbon"
		class={ "ribbon", templ.KV("ribbon-on", subscribed) }
		hx-post={ collectionURL(collectionID) + "/subscribe" }
		hx-swap="outerHTML"
		aria-pressed={ strconv.FormatBool(subscribed) }
		if subscribed {
			title="Subscribed: you are notified of new episodes. Click to unsubscribe."
		} else {
			title="Subscribe to be notified when new episodes are added"
		}
	>
		<span class="ribbon-band" aria-hidden="true">
			@icon("star")
			@icon("check")
		</span>
		<span class="sr-only">
			if subscribed {
				Subscribed
			} else {
				Subscribe
			}
		</span>
	</button>
}

templ resumeList(items []store.Resume) {
	if len(items) == 0 {
		<p class="popover-empty">Nothing paused right now.</p>
	} else {
		<ul class="mini-list">
			for _, resume := range items {
				<li>
					<a href={ watchURL(resume.Media.ID) }>
						<img src={ posterURL(resume.Media.Poster) } alt="" width="40" height="60"/>
						<span>
							{ displayTitle(resume.Media) }
							<small>
								@icon("pause")
								if resume.Media.Duration > 0 {
									{ clock(resume.Position) } of { clock(resume.Media.Duration) }
								} else {
									{ clock(resume.Position) }
								}
							</small>
							if resume.Media.Duration > 0 {
								<span class="progress" aria-hidden="true"><span style={ "width:" + percent(resume.Position, resume.Media.Duration) }></span></span>
							}
						</span>
					</a>
				</li>
			}
		</ul>
	}
}

templ notificationList(items []store.Media, subscriptions int) {
	if len(items) == 0 && subscriptions == 0 {
		<p class="popover-empty">No new episodes. Subscribe to a show from its poster.</p>
	} else if len(items) == 0 {
		<p class="popover-empty">No new episodes in { subscriptionPhrase(subscriptions) }.</p>
	} else {
		<ul class="mini-list">
			for _, mediaItem := range items {
				<li>
					<a href={ watchURL(mediaItem.ID) }>
						<img src={ posterURL(mediaItem.Poster) } alt="" width="40" height="60"/>
						<span>{ displayTitle(mediaItem) }</span>
					</a>
				</li>
			}
		</ul>
	}
}

// searchPage is /search without JavaScript: the home page with the search
// drawer open. When nothing matches, the drawer says so.
templ searchPage(page Page, categories []store.Category, recent []store.Tile, libraryCategories []store.Category) {
	@shellWithSearch(page, searchPageResults(categories)) {
		<section class="panel library-panel" id="library">
			@libraryView(page, recent, libraryCategories)
		</section>
	}
}

templ searchPageResults(categories []store.Category) {
	if len(categories) == 0 {
		<section class="panel message">
			<p>Nothing matches your search.</p>
		</section>
	} else {
		@searchResults(categories)
	}
}

templ collectionPage(page Page, dialog templ.Component) {
	@shell(page) {
		<section class="panel collection-page">
			@dialog
		</section>
	}
}
